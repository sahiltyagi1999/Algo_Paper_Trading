# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/

# Zerodha Kite API credentials
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# Your Netlify URL — e.g. https://my-algo-dashboard.netlify.app
# Use * during development
FRONTEND_URL=*

# JWT Auth — generate a strong random secret for production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Trading parameters (optional — defaults in config.py)
CAPITAL=55000
PROFIT_VAULT=47000
DAILY_LOSS_LIMIT=2000
MAX_TRADES_DAY=3
RISK_PCT=0.015
INSTRUMENT=NIFTY

# Runtime safety
CANDLE_CLOSE_DELAY_SECONDS=20
SIGNAL_POLL_SECONDS=10
MONITOR_INTERVAL_SECONDS=5
IDLE_MONITOR_SECONDS=15
SQUARE_OFF_TIME=15:15
